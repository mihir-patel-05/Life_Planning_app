# Public Supabase config (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Direct Postgres connection for Drizzle migrations
# Get this from Supabase project settings -> Database -> Connection string -> URI
# Use the "session" pooler (port 5432) for migrations
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# Optional: site URL for OAuth redirects in production
NEXT_PUBLIC_SITE_URL=http://localhost:3000
